# 服务器监听（nginx 反代到本端口，勿直接暴露公网）
# 注意：本地开发默认 127.0.0.1:3000；容器内由 docker-compose 强制 HOST=0.0.0.0，
# 请勿在此设置 HOST，否则会覆盖容器监听地址导致端口映射失效。
PORT=3000
NODE_ENV=production

# IBKR Flex Web Service（必填，IBKR Client Portal 里创建 Flex Query 后获取）
IBKR_FLEX_TOKEN=
IBKR_FLEX_QUERY_ID=
IBKR_FLEX_CACHE_SECONDS=600

# Alpha Vantage（可选，财报日历与行情用，免费 key 每天限 25 次）
ALPHA_VANTAGE_API_KEY=
EARNINGS_CACHE_SECONDS=86400
MARKET_CACHE_SECONDS=300
